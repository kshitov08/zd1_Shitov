<Window x:Class="pr2_3_Shitov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr2_3_Shitov"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#FFFFAFAF" Padding="5">
            <MenuItem Header="Выбрать задание">
                <MenuItem Header="Задание 1" Click="ShowTask1"/>
                <MenuItem Header="Задание 2" Click="ShowTask2"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="10">
            <!-- Задание 1 -->
            <Grid x:Name="GridTask1" Visibility="Visible">
                <StackPanel>
                    <TextBlock Text="Задание 1: Магазин" FontWeight="Bold" Margin="0,0,0,10"/>

                    <!--Панель добавления товара-->
                    <Border BorderBrush="#FFCCCCCC" BorderThickness="1" 
                            CornerRadius="5" Padding="10" Margin="0,0,0,10"
                            Background="#FFF9F9F9">
                        <StackPanel>
                            <TextBlock Text="ДОБАВЛЕНИЕ ТОВАРА" 
                                       FontWeight="Bold" FontSize="14" 
                                       Margin="0,0,0,10" Foreground="#FF333333"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0" Content="Название:" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtProductName" Grid.Column="1" Width="150" Margin="0,5,180,5"/>

                                <Label Grid.Column="2" Content="Цена:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBox x:Name="txtPrice" Grid.Column="3" Width="80" Margin="5" TextChanged="txtPrice_TextChanged" Text="00,00"/>
                                <Label Grid.Column="4" Content="руб." VerticalAlignment="Center"/>

                                <Label Grid.Column="5" Content="Кол-во:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBox x:Name="txtCount" Grid.Column="6" Width="60" Margin="5" Text="1"/>
                                <Label Grid.Column="7" Content="шт." VerticalAlignment="Center"/>
                            </Grid>

                            <Button x:Name="btnAdd" Content="ДОБАВИТЬ ТОВАР" 
                                    Width="150" Height="30" Margin="0,10,0,0"
                                    Background="#FF5C9E5C" Foreground="White"
                                    FontWeight="Bold" Click="BtnAdd_Click"/>
                        </StackPanel>
                    </Border>

                    <!--Панель продажа товара-->
                    <Border BorderBrush="#FFCCCCCC" BorderThickness="1" 
                            CornerRadius="5" Padding="10" Margin="0,0,0,10"
                            Background="#FFF9F9F9">
                        <StackPanel>
                            <TextBlock Text="ПРОДАЖА ТОВАРА" 
                                       FontWeight="Bold" FontSize="14" 
                                       Margin="0,0,0,10" Foreground="#FF333333"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.Column="0" Content="Название:" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtSellName" Grid.Column="1" Width="150" Margin="10,5,325,5"/>
                                <Label Grid.Column="1" Content="Кол-во:" VerticalAlignment="Center" Margin="217,0,217,0"/>
                                <TextBox x:Name="txtSellCount" Grid.Column="1" Width="60" Margin="273,5,152,5" Text="1"/>
                                <Label Grid.Column="1" Content="шт." VerticalAlignment="Center" Margin="350,0,108,0"/>
                            </Grid>

                            <Button x:Name="btnSell" Content="ПРОДАТЬ" 
                                    Width="100" Height="30" Margin="0,10,0,0"
                                    Background="#FFE07A7A" Foreground="White"
                                    FontWeight="Bold" Click="BtnSell_Click"/>
                        </StackPanel>
                    </Border>

                    <!--Панель список товаров-->
                    <Border BorderBrush="#FFCCCCCC" BorderThickness="1" 
                            CornerRadius="5" Padding="10"
                            Background="#FFF9F9F9">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="СПИСОК ТОВАРОВ" 
                                       FontWeight="Bold" FontSize="14" 
                                       Margin="0,0,0,10" Foreground="#FF333333"/>

                            <DataGrid Grid.Row="1" x:Name="dgProducts" 
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" 
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      RowHeight="35">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Товар" Width="200" 
                                                        Binding="{Binding ProductName}"/>
                                    <DataGridTextColumn Header="Цена" Width="100" 
                                                        Binding="{Binding ProductPrice, StringFormat=\{0:F2\} руб.}"/>
                                    <DataGridTextColumn Header="В наличии" Width="100" 
                                                        Binding="{Binding Count, StringFormat=\{0\} шт.}"/>
                                    <DataGridTemplateColumn Header="Покупка" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Купить" Width="60" Height="25"
                                                        Background="#FF4CAF50" Foreground="White"
                                                        Click="BuyButton_Click" 
                                                        Tag="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!--Строка с прибылью магазина-->
                    <StatusBar Margin="0,10,0,0">
                        <Separator/>
                        <StatusBarItem>
                            <TextBlock x:Name="txtProfit" Text="Прибыль: 0 руб." FontWeight="Bold"/>
                        </StatusBarItem>
                    </StatusBar>
                </StackPanel>
            </Grid>

            <!--Задание 2: Плейлист-->
            <Grid x:Name="GridTask2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Задание 2: Плейлист" FontWeight="Bold" Margin="0,0,0,10"/>

                <!--Панель добавления песен-->
                <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="Добавить новую песню:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Автор:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtAuthor" Margin="0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Название:" Margin="10, 0" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtTitle" Margin="10,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Файл:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtFilename" Margin="0,5"/>
                            <Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4" x:Name="btnBrowse" 
                                        Content="Обзор..." Width="80" HorizontalAlignment="Left" Margin="5,5" Click="BtnBrowse_Click"/>

                            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" x:Name="btnAddSong" 
                                        Content="Добавить песню" Height="30" Margin="100,10" Click="BtnAddSong_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--Список песен-->
                <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,0" CornerRadius="5">
                    <ListBox Grid.Row="2" x:Name="lstSongs" Margin="0,0,0,10" 
         SelectionChanged="LstSongs_SelectionChanged"
         DisplayMemberPath="."/>
                </Border>

                <!--Панель управления-->
                <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" Padding="10" CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="btnPrev" Content="Предыдущая" 
                                    Margin="5" Click="BtnPrev_Click"/>
                        <Button Grid.Column="1" x:Name="btnNext" Content="Следующая" 
                                    Margin="5" Click="BtnNext_Click"/>
                        <Button Grid.Column="2" x:Name="btnFirst" Content="В начало плейлиста" 
                                    Margin="5" Click="BtnFirst_Click"/>
                        <Button Grid.Column="3" x:Name="btnDelete" Content="Удалить" 
                                    Margin="5" Click="BtnDelete_Click"/>
                        <Button Grid.Column="4" x:Name="btnClear" Content="Очистить всё" 
                                    Margin="5" Click="BtnClear_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>